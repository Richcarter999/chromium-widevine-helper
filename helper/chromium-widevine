def _log_native_event(user_data_dir: Path, event: str, **values) -> None:
    entry = {
        "time": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "event": event,
        "user_data_dir": str(user_data_dir),
    }
    entry.update(values)
    try:
        _native_log_path(user_data_dir).parent.mkdir(parents=True, exist_ok=True)
        with _native_log_path(user_data_dir).open("a", encoding="utf-8") as file:
            file.write(json.dumps(entry, separators=(",", ":")))
            file.write("\n")
    except OSError:
        pass


