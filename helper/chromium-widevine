def _config_home() -> Path:
    xdg_config_home = os.environ.get("XDG_CONFIG_HOME")
    if xdg_config_home:
        return Path(xdg_config_home).expanduser()
    return Path.home() / ".config"


def _default_user_data_dir() -> Path:
    return _config_home() / "chromium"


def _abs_path(path: str) -> Path:
    expanded = Path(os.path.expanduser(path))
    if expanded.is_absolute():
        return expanded
    return (Path.cwd() / expanded).resolve()


def _same_path(left: Path, right: Path) -> bool:
    try:
        return left.expanduser().resolve() == right.expanduser().resolve()
    except OSError:
        return left.expanduser().absolute() == right.expanduser().absolute()


def _user_data_dir_from_args(args: list[str]) -> Path | None:
    for index, arg in enumerate(args):
        if arg.startswith("--user-data-dir="):
            return _abs_path(arg.split("=", 1)[1])
        if arg == "--user-data-dir" and index + 1 < len(args):
            return _abs_path(args[index + 1])
    return None


def _browser_config_dir_from_process(exe_path: str, args: list[str]) -> Path | None:
    names = set()
    values = [exe_path]
    values.extend(args[:2])
    for value in values:
        if value:
            names.add(Path(value).name.lower())

    text = " ".join(value.lower() for value in values if value)
    if "/opt/google/chrome-unstable/" in text:
        return _config_home() / "google-chrome-unstable"
    if "/opt/google/chrome-beta/" in text:
        return _config_home() / "google-chrome-beta"
    if "/opt/google/chrome/" in text:
        return _config_home() / "google-chrome"
    if "/opt/brave.com/brave-nightly/" in text:
        return _config_home() / "BraveSoftware" / "Brave-Browser-Nightly"
    if "/opt/brave.com/brave-beta/" in text:
        return _config_home() / "BraveSoftware" / "Brave-Browser-Beta"
    if "/opt/brave.com/brave/" in text:
        return _config_home() / "BraveSoftware" / "Brave-Browser"
    if "/opt/microsoft/msedge-dev/" in text:
        return _config_home() / "microsoft-edge-dev"
    if "/opt/microsoft/msedge-beta/" in text:
        return _config_home() / "microsoft-edge-beta"
    if "/opt/microsoft/msedge/" in text:
        return _config_home() / "microsoft-edge"

    for browser_names, config_parts in BROWSER_CONFIG_DIRS:
        if names.intersection(browser_names):
            return _config_home().joinpath(*config_parts)
    return None


def _read_process_cmdline(pid: int) -> list[str]:
    try:
        data = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return []
    args = [part.decode("utf-8", "replace") for part in data.split(b"\0") if part]
    if len(args) == 1 and " " in args[0] and (" --" in args[0] or args[0].startswith("/")):
        try:
            parsed = shlex.split(args[0])
        except ValueError:
            parsed = args[0].split()
        if parsed:
            return parsed
    return args


def _read_process_exe(pid: int) -> str:
    try:
        return os.readlink(f"/proc/{pid}/exe")
    except OSError:
        return ""


def _read_parent_pid(pid: int) -> int | None:
    try:
        stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    end = stat.rfind(")")
    if end < 0:
        return None
    fields = stat[end + 2:].split()
    if len(fields) < 2:
        return None
    try:
        return int(fields[1])
    except ValueError:
        return None


def _process_chain(start_pid: int | None = None, limit: int = 8):
    pid = start_pid if start_pid is not None else os.getppid()
    seen = set()
    for _ in range(limit):
        if pid <= 1 or pid in seen:
            return
        seen.add(pid)
        args = _read_process_cmdline(pid)
        exe_path = _read_process_exe(pid)
        yield pid, exe_path, args
        parent = _read_parent_pid(pid)
        if parent is None:
            return
        pid = parent


def _processes_from_proc():
    try:
        proc_entries = list(Path("/proc").iterdir())
    except OSError:
        return

    for entry in proc_entries:
        if not entry.name.isdigit():
            continue
        try:
            pid = int(entry.name)
        except ValueError:
            continue
        yield pid, _read_process_exe(pid), _read_process_cmdline(pid)


def _processes_from_ps():
    try:
        result = subprocess.run(
            ["ps", "-ww", "-eo", "pid=,args="],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=3,
        )
    except (OSError, subprocess.SubprocessError):
        return

    if result.returncode != 0:
        return

    for line in result.stdout.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        pid_text, separator, command = stripped.partition(" ")
        if not separator or not command:
            continue
        try:
            pid = int(pid_text)
        except ValueError:
            continue
        try:
            args = shlex.split(command)
        except ValueError:
            args = command.split()
        if not args:
            continue
        exe_path = args[0]
        if exe_path and not exe_path.startswith("/"):
            exe_path = shutil.which(exe_path) or exe_path
        yield pid, exe_path, args


def _browser_path_from_parent_process() -> str | None:
    for _pid, exe_path, args in _process_chain():
        if _browser_config_dir_from_process(exe_path, args):
            return exe_path or (args[0] if args else None)
    return None


def _process_user_data_dir(exe_path: str, args: list[str]) -> Path | None:
    return _user_data_dir_from_args(args) or _browser_config_dir_from_process(exe_path, args)


def _is_browser_main_process(args: list[str]) -> bool:
    return bool(args) and not any(arg.startswith("--type=") or " --type=" in arg for arg in args)


def _add_restart_candidate(
    candidates: list[tuple[int, int, str, list[str]]],
    user_data_dir: Path,
    pid: int,
    exe_path: str,
    args: list[str],
    base_score: int,
) -> None:
    if not _is_browser_main_process(args):
        return

    process_user_data_dir = _process_user_data_dir(exe_path, args)
    if process_user_data_dir is None or not _same_path(process_user_data_dir, user_data_dir):
        return

    browser_path = exe_path or args[0]
    if not browser_path:
        return

    score = base_score
    if _args_load_bundled_extension(args):
        score += 8
    if _browser_config_dir_from_process(browser_path, args):
        score += 4
    candidates.append((score, pid, browser_path, args))


def _running_browser_process(user_data_dir: Path) -> tuple[int, str, list[str]] | None:
    candidates: list[tuple[int, int, str, list[str]]] = []
    seen: set[int] = set()

    for pid, exe_path, args in _process_chain(limit=16):
        seen.add(pid)
        _add_restart_candidate(candidates, user_data_dir, pid, exe_path, args, 100)

    for pid, exe_path, args in _processes_from_proc():
        if pid in seen:
            continue
        _add_restart_candidate(
            candidates,
            user_data_dir,
            pid,
            exe_path,
            args,
            0,
        )

    for pid, exe_path, args in _processes_from_ps():
        _add_restart_candidate(
            candidates,
            user_data_dir,
            pid,
            exe_path,
            args,
            0,
        )

    if not candidates:
        return None

    _score, pid, browser_path, args = sorted(candidates, key=lambda item: item[0])[-1]
    return pid, browser_path, args


def _user_data_dir_from_parent_process() -> Path | None:
    process_infos = list(_process_chain())
    for _pid, _exe_path, args in process_infos:
        user_data_dir = _user_data_dir_from_args(args)
        if user_data_dir:
            return user_data_dir

    for _pid, exe_path, args in process_infos:
        browser_dir = _browser_config_dir_from_process(exe_path, args)
        if browser_dir:
            return browser_dir
    return None


def _configured_user_data_dir() -> Path | None:
    if os.environ.get("CHROMIUM_WIDEVINE_DISCOVER_RUNNING_BROWSER"):
        return None
    for name in (
        "CHROMIUM_WIDEVINE_USER_DATA_DIR",
        "CHROMIUM_USER_DATA_DIR",
    ):
        value = os.environ.get(name)
        if value:
            return _abs_path(value)
    return None


def _profile_has_bundled_extension(user_data_dir: Path) -> bool:
    for pref_path in _profile_preference_files(user_data_dir):
        prefs = _read_json(pref_path, None)
        if not isinstance(prefs, dict):
            continue
        extensions = prefs.get("extensions", {})
        if not isinstance(extensions, dict):
            continue
        settings = extensions.get("settings", {})
        entry = settings.get(EXTENSION_ID) if isinstance(settings, dict) else None
        if isinstance(entry, dict) and _extension_entry_matches_bundled_path(entry):
            return True
    return False


def _valid_extension_id(extension_id: str) -> bool:
    return bool(re.fullmatch(r"[a-p]{32}", extension_id))


def _extension_path_candidates(pref_path: Path, path: str) -> list[Path]:
    extension_path = Path(path).expanduser()
    if extension_path.is_absolute():
        return [extension_path]
    return [
        pref_path.parent / "Extensions" / extension_path,
        pref_path.parent / extension_path,
    ]


def _path_contains_widevine_extension(path: Path) -> bool:
    manifest = _read_json(path / "manifest.json", {})
    if not isinstance(manifest, dict):
        return False
    if manifest.get("name") != "__MSG_extensionName__":
        return False
    if manifest.get("default_locale") != "en":
        return False
    permissions = manifest.get("permissions", [])
    if not isinstance(permissions, list) or "nativeMessaging" not in permissions:
        return False
    background = manifest.get("background", {})
    if not isinstance(background, dict) or background.get("service_worker") != "background.js":
        return False
    try:
        return HOST_NAME in (path / "background.js").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False


def _extension_entry_is_widevine(pref_path: Path, entry: dict) -> bool:
    if _extension_entry_matches_bundled_path(entry):
        return True

    manifest = entry.get("manifest")
    if isinstance(manifest, dict):
        permissions = manifest.get("permissions", [])
        background = manifest.get("background", {})
        if (
            manifest.get("name") == "__MSG_extensionName__"
            and isinstance(permissions, list)
            and "nativeMessaging" in permissions
            and isinstance(background, dict)
            and background.get("service_worker") == "background.js"
        ):
            return True

    path = entry.get("path")
    if not isinstance(path, str) or not path:
        return False
    return any(_path_contains_widevine_extension(candidate) for candidate in _extension_path_candidates(pref_path, path))


def _widevine_extension_ids(user_data_dir: Path) -> set[str]:
    extension_ids = {EXTENSION_ID}
    for pref_path in _profile_preference_files(user_data_dir):
        prefs = _read_json(pref_path, None)
        if not isinstance(prefs, dict):
            continue
        settings = prefs.get("extensions", {}).get("settings", {})
        if not isinstance(settings, dict):
            continue
        for extension_id, entry in settings.items():
            if (
                isinstance(extension_id, str)
                and _valid_extension_id(extension_id)
                and isinstance(entry, dict)
                and _extension_entry_is_widevine(pref_path, entry)
            ):
                extension_ids.add(extension_id)
    return extension_ids


def _args_load_bundled_extension(args: list[str]) -> bool:
    extension_path = str(EXTENSION_PATH)
    index = 0
    while index < len(args):
        arg = args[index]
        if arg.startswith("--load-extension="):
            values = arg.split("=", 1)[1].split(",")
            if extension_path in values:
                return True
        if arg == "--load-extension" and index + 1 < len(args):
            values = args[index + 1].split(",")
            if extension_path in values:
                return True
            index += 1
        index += 1
    return False


def _user_data_dir_from_running_browser() -> Path | None:
    candidates: dict[Path, int] = {}
    browser_config_dir_value = os.environ.get("CHROMIUM_WIDEVINE_BROWSER_CONFIG_DIR")
    browser_config_dir = _abs_path(browser_config_dir_value) if browser_config_dir_value else None

    for _pid, exe_path, args in list(_processes_from_proc() or []) + list(_processes_from_ps() or []):
        user_data_dir = _user_data_dir_from_args(args)
        if user_data_dir is None:
            user_data_dir = _browser_config_dir_from_process(exe_path, args)
        if user_data_dir is None:
            continue

        score = 1
        if args and not any(arg.startswith("--type=") for arg in args):
            score += 2
        if _args_load_bundled_extension(args):
            score += 8
        if _profile_has_bundled_extension(user_data_dir):
            score += 4
        if browser_config_dir and _same_path(user_data_dir, browser_config_dir):
            score += 16
        candidates[user_data_dir] = max(candidates.get(user_data_dir, 0), score)

    if not candidates:
        return None
    return sorted(candidates.items(), key=lambda item: item[1])[-1][0]


def _active_user_data_dir(discover_running_browser: bool = False) -> Path:
    return (
        _configured_user_data_dir()
        or _user_data_dir_from_parent_process()
        or (_user_data_dir_from_running_browser() if discover_running_browser else None)
        or _default_user_data_dir()
    )


def _parse_user_data_dir(args: list[str], browser_path: str | None = None) -> Path:
    user_data_dir = _user_data_dir_from_args(args)
    if user_data_dir:
        return user_data_dir
    if browser_path:
        browser_dir = _browser_config_dir_from_process(browser_path, [browser_path])
        if browser_dir:
            return browser_dir
    return _default_user_data_dir()


